# Clé API Anthropic (obligatoire pour le mode IA) — https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Modèle Claude utilisé pour l'analyse virale
CLAUDE_MODEL=claude-opus-5

# Modèle Whisper local : tiny | base | small | medium | large-v3
# "small" est un bon compromis vitesse/qualité sur CPU, "medium"+ si GPU
WHISPER_MODEL=small

# Device Whisper : auto | cpu | cuda
WHISPER_DEVICE=auto

# Dossier de travail (téléchargements + clips générés)
DATA_DIR=./data

# Nombre max de clips proposés par vidéo
MAX_CLIPS=5
